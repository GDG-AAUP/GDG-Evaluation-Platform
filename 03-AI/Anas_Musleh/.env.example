# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.

# "mock" = fake local data (works today). "real" = the team's Node backend.
BACKEND_MODE=mock
BACKEND_URL=http://localhost:3001

# Free key from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=
# Check the exact model name that is free for your key in AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Safety limit: how many tool calls the model may chain for one question.
MAX_TOOL_ROUNDS=6
# Optional: pin "today" (useful for repeatable tests).
# MOCK_TODAY=2026-10-23
