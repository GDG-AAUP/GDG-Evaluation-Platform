# Copy to .env.local and adjust.
#
# true  = run against the built-in mock backend (src/services/mock), no server needed.
# false = call the real REST API described in docs/API_CONTRACT.md
VITE_USE_MOCK=true

# Base URL of the real backend (used only when VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8000/api
