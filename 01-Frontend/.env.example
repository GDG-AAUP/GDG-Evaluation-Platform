# Copy to .env.local and adjust. On Vercel, set these in Project Settings -> Environment Variables.
# Vite bakes VITE_* values into the bundle at BUILD time: redeploy after changing any of them.
#
# true  = run against the built-in mock backend (src/services/mock), no server needed.
# false = call the real REST API described in docs/API_CONTRACT.md
# PRODUCTION: must be false (otherwise the site runs on demo data and never calls the backend).
VITE_USE_MOCK=true

# Base URL of the real backend (used only when VITE_USE_MOCK=false)
# 02-Backend listens on port 3001 and mounts everything under /api
# PRODUCTION example: https://gdg-backend.onrender.com/api   (keep the /api suffix, no trailing slash)
VITE_API_URL=http://localhost:3001/api

# Clerk PUBLISHABLE key (pk_test_... / pk_live_...). Public and safe in the browser.
# Required only when VITE_USE_MOCK=false. NEVER put the secret key (sk_...) here.
# See docs/CLERK_SETUP.md
VITE_CLERK_PUBLISHABLE_KEY=
