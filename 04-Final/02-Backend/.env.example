# Never commit the real .env. On Render/Railway set these as service environment variables.
# PRODUCTION: NODE_ENV=production. PORT is usually injected by the host; 3001 is the local default.
NODE_ENV=development
PORT=3001
# PostgreSQL connection: EITHER the five DB_* variables below, OR one DATABASE_URL
# (postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require). DATABASE_URL is used only when
# DB_HOST is empty or absent. Use the provider's DIRECT / session-mode connection (not a
# transaction-mode pooler such as port 6543).
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gdg_evaluation
DB_USER=postgres
DB_PASSWORD=
# Hosted PostgreSQL (Supabase / Neon / Railway public URL) needs TLS. node-postgres reads PGSSLMODE:
#   require   = TLS with certificate verification
#   no-verify = TLS without verification (use if the provider's certificate chain is rejected)
# Leave unset for a local database.
# PGSSLMODE=require
# Clerk keys from the Clerk dashboard (API Keys). The publishable key (pk_...) is the same one the
# frontend uses; the secret key (sk_...) is server-only and must never reach the frontend.
# Both keys must come from the same Clerk instance (test pk_test_/sk_test_, or live pk_live_/sk_live_).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where invited users land after accepting a Clerk invitation, e.g. https://gdg-eval.vercel.app/
CLERK_INVITATION_REDIRECT_URL=
# Allowed difference from Clerk's clock. Defaults: 60000 outside production, 5000 in production.
# CLERK_CLOCK_SKEW_MS=60000
# Super Admins: comma-separated Clerk user IDs (Clerk dashboard -> Users -> user ID, "user_...").
# A listed account must also be an active Organizer in the database. Only Super Admins may manage
# Organizer accounts and change governance settings (GET/PATCH /api/governance/settings).
# Super Admin accounts themselves can never be edited, deactivated or deleted through the API.
SUPER_ADMIN_CLERK_IDS=user_3M1Z7ML4LaD8wzKQ3uFUWno1rts,user_3M1XM4h4KFxca8JRvCNgfx1sB3y
# Comma-separated browser origins allowed to call this API (scheme + host, no path, no trailing slash).
# PRODUCTION example: CORS_ORIGINS=https://gdg-eval.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Private Python chatbot service (03-AI) = the "AI service URL". Use the same CHATBOT_INTERNAL_KEY in its .env.
# PRODUCTION example: CHATBOT_URL=https://gdg-ai.onrender.com  (no trailing slash, no /chat)
# Generate the shared key once, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_URL=http://127.0.0.1:8000
CHATBOT_INTERNAL_KEY=
# Must stay above the chatbot's own CHAT_DEADLINE_S (25 s). Default when unset: 30000.
CHATBOT_TIMEOUT_MS=30000
# Transactional email for registration decisions (approve / reject). Leave SMTP_HOST empty to
# disable sending; decisions still work and the request records notification_status=skipped.
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# Sign-in link in approval emails. Default: the origin of CLERK_INVITATION_REDIRECT_URL + /#/login.
# APP_LOGIN_URL=https://gdg-eval.vercel.app/#/login
